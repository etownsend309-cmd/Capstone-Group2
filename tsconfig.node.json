{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is needed because Playwright's page.evaluate callbacks are typed
    // against the browser, even though the test file itself runs in Node.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // vite/client is needed because the benchmark script imports src/pdf, which
    // declares the PDF.js worker URL with Vite's `?url` suffix.
    "types": ["node", "vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["scripts", "tests/e2e", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
